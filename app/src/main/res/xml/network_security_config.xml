<?xml version="1.0" encoding="utf-8"?>
<!-- Navidrome is reached over Tailscale, usually as plain http://100.x.y.z:4533 -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
